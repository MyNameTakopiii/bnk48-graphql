{
  "name": "bnk48-graphql",
  "version": "1.0.0",
  "description": "48th Members GraphQL API Service — BNK48 & CGM48 member profiles",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "build": "bun build ./index.ts --outfile ./dist/index.js --target bun && bun build ./src/graphql.ts --outfile ./api/graphql.js --target node",
    "start": "bun ./dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "fmt": "bunx prettier . --write"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@pothos/core": "^4.12.0",
    "graphql": "^16.14.0",
    "graphql-yoga": "^5.21.0"
  }
}
